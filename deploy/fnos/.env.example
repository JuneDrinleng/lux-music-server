# 仅占位符！部署前运行 openssl rand -hex 32 替换此值；不要提交真实 .env。
LUX_TOKEN_SECRET=REPLACE_WITH_OUTPUT_OF_openssl_rand_-hex_32
# 可选：首次启动时同时填写，创建管理员后可清空；不是修改已有账号密码的方式。
LUX_ADMIN_USER=
LUX_ADMIN_PASSWORD=
# 确认可信代理的实际 IP/CIDR 后填写，例如 172.18.0.1/32；默认关闭。
LUX_TRUST_PROXY=0
# 可选：替换为实际 HTTPS 域名，无末尾斜杠；未配置可留空。
LUX_PUBLIC_URL=https://lux.example.com
